# Fictional teaching data, library case v0.1, 2026-11-04.
@prefix lib: <https://example.org/kg-course/library/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lib:Work001 a lib:Work ;
    lib:title "知识图谱入门"@zh ;
    lib:authoredBy lib:Author001, lib:Author002 ;
    lib:about lib:Subject001 .
lib:Work002 a lib:Work ;
    lib:title "数据库实践"@zh ;
    lib:authoredBy lib:Author001, lib:Author003 ;
    lib:about lib:Subject002 .

lib:Author001 a lib:Author ; rdfs:label "林岚"@zh .
lib:Author002 a lib:Author ; rdfs:label "梅雨"@zh .
lib:Author003 a lib:Author ; rdfs:label "陈河"@zh .
lib:Reader001 a lib:Reader ; rdfs:label "许宁"@zh .
lib:Subject001 a lib:Subject ; rdfs:label "知识图谱"@zh .
lib:Subject002 a lib:Subject ; rdfs:label "数据库"@zh .
lib:Library001 a lib:Library ; rdfs:label "星河大学图书馆"@zh .

lib:Edition001 a lib:Edition ;
    lib:editionOf lib:Work001 ;
    lib:teachingEditionId "ED-001" ;
    lib:language "zh" ;
    lib:publicationYear "2024"^^xsd:gYear .
lib:Edition002 a lib:Edition ;
    lib:editionOf lib:Work002 ;
    lib:teachingEditionId "ED-002" ;
    lib:language "zh" ;
    lib:publicationYear "2025"^^xsd:gYear .

lib:Copy001 a lib:Copy ;
    lib:copyOf lib:Edition001 ;
    lib:heldBy lib:Library001 ;
    lib:inventoryId "DEMO-C001" ;
    lib:availability "available" .
lib:Copy002 a lib:Copy ;
    lib:copyOf lib:Edition001 ;
    lib:heldBy lib:Library001 ;
    lib:inventoryId "DEMO-C002" ;
    lib:availability "borrowed" .
