.@SpellModifierDescriptionAppend@","range":[810.0000,810.0000,810.0000,810.0000,810.0000,810.0000],"costCoefficients":[50.0000,55.0000,60.0000,65.0000,70.0000,75.0000],"cooldownCoefficients":[12.0000,11.5000,11.0000,10.5000,10.0000,10.0000],"coefficients":{"coefficient1":0.3000,"coefficient2":0.0000},"effectAmounts":{"Effect1Amount":[0.0000,0.0000,0.0000,0.0000,0.0000,0.0000,0.0000],"Effect2Amount":[0.0000,0.0000,0.0000,0.0000,0.0000,0.0000,0.0000],"Effect3Amount":[0.0000,0.0000,0.0000,0.0000,0.0000,0.0000,0.0000],"Effect4Amount":[0.0000,0.0000,0.0000,0.0000,0.0000,0.0000,0.0000],"Effect5Amount":[0.0000,0.0000,0.0000,0.0000,0.0000,0.0000,0.0000],"Effect6Amount":[0.0000,0.0000,0.0000,0.0000,0.0000,0.0000,0.0000],"Effect7Amount":[0.0000,0.0000,0.0000,0.0000,0.0000,0.0000,0.0000],"Effect8Amount":[0.0000,0.0000,0.0000,0.0000,0.0000,0.0000,0.0000],"Effect9Amount":[0.0000,0.0000,0.0000,0.0000,0.0000,0.0000,0.0000],"Effect10Amount":[0.0000,0.0000,0.0000,0.0000,0.0000,0.0000,0.0000]},"ammo":{"ammoRechargeTime":[0.0000,0.0000,0.0000,0.0000,0.0000,0.0000],"maxAmmo":[0,0,0,0,0,0]},"maxLevel":0},{"spellKey":"r","name":"Луч дезинтеграции форм жизни","abilityIconPath":"/lol-game-data/assets/ASSETS/Characters/Velkoz/HUD/Icons2D/Velkoz_R.png","abilityVideoPath":"champion-abilities/0161/ability_0161_R1.webm","abilityVideoImagePath":"champion-abilities/0161/ability_0161_R1.jpg","cost":"@AbilityResourceName@: @Cost@","cooldown":"@Cooldown@ сек. %i:cooldown%","description":"Вел'Коз испускает луч, который следует за курсором в течение 2.5 секунд и наносит магический урон. Органический распад изучает вражеских чемпионов и наносит изученным целям чистый урон.","dynamicDescription":"Вел'Коз выпускает луч энергии, который следует за курсором, наносит в общей сложности <magicDamage>@TotalDamage@ магического урона</magicDamage> в течение 2.5 сек. и <status>замедляет</status> на @Effect3Amount@%. Это умение наносит <trueDamage>чистый урон</trueDamage> врагам, которые недавно были поражены умением <spellName>Органический распад</spellName>.<br><br>Враги, которых поражает луч, периодически получают заряды <keywordMajor>Распада</keywordMajor>.@SpellModifierDescriptionAppend@","range":[1575.0000,1575.0000,1575.0000,1575.0000,1575.0000,1575.0000],"costCoefficients":[100.0000,100.0000,100.0000,0.0000,0.0000,0.0000],"cooldownCoefficients":[100.0000,90.0000,80.0000,10.0000,10.0000,10.0000],"coefficients":{"coefficient1":1.2500,"coefficient2":0.0000},"effectAmounts":{"Effect1Amount":[0.0000,450.0000,700.0000,925.0000,0.0000,0.0000,0.0000],"Effect2Amount":[7.0000,7.0000,7.0000,7.0000,7.0000,7.0000,7.0000],"Effect3Amount":[0.0000,20.0000,20.0000,20.0000,0.0000,0.0000,0.0000],"Effect4Amount":[40.0000,40.0000,40.0000,40.0000,40.0000,40.0000,40.0000],"Effect5Amount":[175.0000,175.0000,175.0000,175.0000,175.0000,175.0000,175.0000],"Effect6Amount":[7.0000,7.0000,7.0000,7.0000,7.0000,7.0000,7.0000],"Effect7Amount":[0.0000,0.0000,0.0000,0.0000,0.0000,0.0000,0.0000],"Effect8Amount":[0.0000,0.0000,0.0000,0.0000,0.0000,0.0000,0.0000],"Effect9Amount":[0.0000,0.0000,0.0000,0.0000,0.0000,0.0000,0.0000],"Effect10Amount":[0.0000,0.0000,0.0000,0.0000,0.0000,0.0000,0.0000]},"ammo":{"ammoRechargeTime":[0.0000,0.0000,0.0000,0.0000,0.0000,0.0000],"maxAmmo":[0,0,0,0,0,0]},"maxLevel":0}]}