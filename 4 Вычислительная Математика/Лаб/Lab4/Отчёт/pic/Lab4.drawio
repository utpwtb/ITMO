<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="LSM Block Diagram">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Start -->
        <mxCell id="2" value="Начало" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="20" width="140" height="50" as="geometry" />
        </mxCell>
        
        <!-- Input -->
        <mxCell id="3" value="Ввод данных&#xa;x[i], y[i] (8-12 точек)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="200" height="60" as="geometry" />
        </mxCell>
        
        <!-- Initialize -->
        <mxCell id="4" value="Инициализация функций&#xa;(линейная, квадратичная,&#xa;кубическая, экспоненциальная,&#xa;логарифмическая, степенная)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="190" width="240" height="80" as="geometry" />
        </mxCell>
        
        <!-- Loop start -->
        <mxCell id="5" value="Для каждой функции" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="305" y="300" width="190" height="70" as="geometry" />
        </mxCell>
        
        <!-- LSM step -->
        <mxCell id="6" value="Вычисление сумм для МНК&#xa;(Σx, Σxx, Σy, Σxy, ...)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="410" width="220" height="60" as="geometry" />
        </mxCell>
        
        <!-- Solve -->
        <mxCell id="7" value="Решение системы уравнений&#xa;методом Гаусса или&#xa;линеаризация + МНК" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="500" width="220" height="60" as="geometry" />
        </mxCell>
        
        <!-- Quality -->
        <mxCell id="8" value="Вычисление S, δ, R²&#xa;φ(x_i), ε_i" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="590" width="220" height="60" as="geometry" />
        </mxCell>
        
        <!-- Loop end -->
        <mxCell id="9" value="Все функции&#xa;обработаны?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="305" y="690" width="190" height="70" as="geometry" />
        </mxCell>
        
        <!-- Best selection -->
        <mxCell id="10" value="Выбор наилучшей функции&#xa;(min δ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="800" width="200" height="60" as="geometry" />
        </mxCell>
        
        <!-- Output -->
        <mxCell id="11" value="Вывод результатов:&#xa;коэффициенты, таблица,&#xa;графики, лучшая функция" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="890" width="240" height="70" as="geometry" />
        </mxCell>
        
        <!-- End -->
